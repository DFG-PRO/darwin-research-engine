DARWIN_ENV=local
DARWIN_LOG_LEVEL=INFO
DARWIN_VERSION=0.1.0
DARWIN_RESEARCH_METHOD_VERSION=0.1.0
DARWIN_ARTIFACT_ROOT=artifacts
DARWIN_DATABASE_URL=postgresql+psycopg://darwin:darwin@localhost:5432/darwin
DARWIN_EXTERNAL_SEARCH_PROVIDER=fake
DARWIN_EXTERNAL_SEARCH_TIMEOUT_SECONDS=10
DARWIN_EXTERNAL_SEARCH_MAX_RETRIES=1
DARWIN_EXTERNAL_SEARCH_USER_AGENT=DarwinResearchEngine/0.1
# Required only when DARWIN_EXTERNAL_SEARCH_PROVIDER=brave.
DARWIN_BRAVE_SEARCH_API_KEY=
DARWIN_SOURCE_FETCH_TIMEOUT_SECONDS=10
DARWIN_SOURCE_FETCH_MAX_RETRIES=1
DARWIN_SOURCE_FETCH_USER_AGENT=DarwinResearchEngine/0.1
DARWIN_SOURCE_FETCH_MAX_BYTES=1000000
DARWIN_SOURCE_CONTENT_RETRIEVAL_METHOD_VERSION=source-fetch-http-1.8g
DARWIN_SOURCE_CONTENT_NORMALIZATION_METHOD_VERSION=html-text-normalization-1.8g
DARWIN_EVIDENCE_EXTRACTION_METHOD_VERSION=segment-extraction-1.8g
DARWIN_EVIDENCE_EXCERPT_MAX_CHARS=4000
DARWIN_CLAIM_CONSTRUCTION_METHOD_VERSION=manual-explicit-claim-construction-1.8h
DARWIN_STRUCTURED_SYNTHESIS_METHOD_VERSION=structured-synthesis-1.8h
DARWIN_CLAIM_STATEMENT_MAX_CHARS=2000
DARWIN_RESEARCH_PLANNING_PROVIDER=fake
DARWIN_RESEARCH_PLANNING_MODEL=fake-deterministic-planner-v1
DARWIN_RESEARCH_PLANNING_METHOD_VERSION=research-planning-1.9a
DARWIN_RESEARCH_PLANNING_PROMPT_VERSION=research-planning-prompt-1.9a
DARWIN_RESEARCH_PLANNING_SCHEMA_VERSION=research-plan-proposal-schema-1.9a
DARWIN_RESEARCH_PLANNING_TIMEOUT_SECONDS=20
DARWIN_RESEARCH_PLANNING_MAX_PLAN_ITEMS=8
DARWIN_RESEARCH_PLANNING_MAX_REQUIRED_PLAN_ITEMS=6
DARWIN_RESEARCH_PLANNING_MAX_CATEGORIES=6
DARWIN_RESEARCH_PLANNING_MAX_BREADTH=5
DARWIN_RESEARCH_PLANNING_MAX_DEPTH=3
# Required when a configured planning, assisted extraction, assisted claim construction, or narrative synthesis provider uses OpenAI.
DARWIN_OPENAI_API_KEY=
DARWIN_ASSISTED_EVIDENCE_EXTRACTION_PROVIDER=fake
DARWIN_ASSISTED_EVIDENCE_EXTRACTION_MODEL=fake-evidence-extractor-v1
DARWIN_ASSISTED_EVIDENCE_EXTRACTION_METHOD_VERSION=assisted-evidence-extraction-1.9b
DARWIN_ASSISTED_EVIDENCE_EXTRACTION_PROMPT_VERSION=assisted-evidence-extraction-prompt-1.9b
DARWIN_ASSISTED_EVIDENCE_EXTRACTION_SCHEMA_VERSION=evidence-candidate-proposal-schema-1.9b
DARWIN_ASSISTED_EVIDENCE_EXTRACTION_TIMEOUT_SECONDS=20
DARWIN_ASSISTED_EVIDENCE_EXTRACTION_MAX_SEGMENTS=5
DARWIN_ASSISTED_EVIDENCE_EXTRACTION_MAX_CANDIDATES=5
DARWIN_ASSISTED_EVIDENCE_EXTRACTION_MAX_SEGMENT_CHARS=4000
DARWIN_ASSISTED_EVIDENCE_EXTRACTION_MAX_TOTAL_REQUEST_CHARS=12000
DARWIN_ASSISTED_CLAIM_CONSTRUCTION_PROVIDER=fake
DARWIN_ASSISTED_CLAIM_CONSTRUCTION_MODEL=fake-claim-constructor-v1
DARWIN_ASSISTED_CLAIM_CONSTRUCTION_METHOD_VERSION=assisted-claim-construction-1.9c
DARWIN_ASSISTED_CLAIM_CONSTRUCTION_PROMPT_VERSION=assisted-claim-construction-prompt-1.9c
DARWIN_ASSISTED_CLAIM_CONSTRUCTION_SCHEMA_VERSION=claim-candidate-proposal-schema-1.9c
DARWIN_ASSISTED_CLAIM_CONSTRUCTION_TIMEOUT_SECONDS=20
DARWIN_ASSISTED_CLAIM_CONSTRUCTION_MAX_EVIDENCE_ITEMS=8
DARWIN_ASSISTED_CLAIM_CONSTRUCTION_MAX_EVIDENCE_CHARS=12000
DARWIN_ASSISTED_CLAIM_CONSTRUCTION_MAX_CANDIDATES=5
DARWIN_ASSISTED_CLAIM_CONSTRUCTION_MAX_CLAIM_CHARS=1000
DARWIN_ASSISTED_CLAIM_CONSTRUCTION_MAX_QUALIFIERS=6
DARWIN_ASSISTED_CLAIM_CONSTRUCTION_MAX_ASSUMPTIONS=6
DARWIN_NARRATIVE_SYNTHESIS_PROVIDER=fake
DARWIN_NARRATIVE_SYNTHESIS_MODEL=fake-narrative-synthesis-v1
DARWIN_NARRATIVE_SYNTHESIS_METHOD_VERSION=narrative-synthesis-1.9d
DARWIN_NARRATIVE_SYNTHESIS_PROMPT_VERSION=narrative-synthesis-prompt-1.9d
DARWIN_NARRATIVE_SYNTHESIS_SCHEMA_VERSION=narrative-synthesis-proposal-schema-1.9d
DARWIN_NARRATIVE_SYNTHESIS_TIMEOUT_SECONDS=20
DARWIN_NARRATIVE_SYNTHESIS_MAX_CLAIMS=25
DARWIN_NARRATIVE_SYNTHESIS_MAX_EVIDENCE_ITEMS=60
DARWIN_NARRATIVE_SYNTHESIS_MAX_EVIDENCE_CHARS=20000
DARWIN_NARRATIVE_SYNTHESIS_MAX_FINDINGS=20
DARWIN_NARRATIVE_SYNTHESIS_MAX_REPORT_CHARS=50000
DARWIN_NARRATIVE_SYNTHESIS_MAX_ASSUMPTIONS=10
DARWIN_NARRATIVE_SYNTHESIS_MAX_LIMITATIONS=10
